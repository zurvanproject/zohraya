    "reproduction_js": "const cases={\"null\":{\"c\":0,\"d\":0},\"facilitation\":{\"c\":0.9,\"d\":0.05},\"interference\":{\"c\":-0.45,\"d\":0.45}},difficulty=[0.45,0.45,0.45,0.55,0.4],pulses=[0.2,0.6,1,0.6,0.2],sig=x=>1/(1+Math.exp(-x));\nfunction traj(seed,arm,{c,d}){let s=seed>>>0;const rng=()=>((s=(Math.imul(s,1664525)+1013904223)>>>0)/4294967296);let skills=difficulty.map(()=>-.5+(rng()-.5)*.32),curve=[];for(let t=0;t<8;t++){for(let pass=0;pass<3;pass++)for(let j=0;j<5;j++){const pulse=arm===\"B\"?pulses[j]:0,p=sig(skills[j]-difficulty[j]-pulse*d),correct=rng()<p;skills[j]+=.035*(1+c*pulse)*(.65+.6*(1-p))*(correct?1:1.08)}curve.push(skills.reduce((sum,x,j)=>sum+sig(x-difficulty[j]),0)/5)}return curve}\nfunction run(){let output={};for(const [name,cfg] of Object.entries(cases)){let means={A:Array(8).fill(0),B:Array(8).fill(0)};for(let seed=116000;seed<117000;seed++)for(const arm of [\"A\",\"B\"]){const v=traj(seed,arm,cfg);v.forEach((x,j)=>means[arm][j]+=x/1000)}const gainA=means.A[7]-means.A[0],gainB=means.B[7]-means.B[0];output[name]={curves:means,gainA,gainB,delta:gainB-gainA}}if(output.null.curves.A.some((v,j)=>v!==output.null.curves.B[j]))throw Error(\"null control failed\");return output}\nconsole.log(JSON.stringify(run()));"
