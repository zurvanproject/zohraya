  ],
  "body_acceptance": [
    "select and execute an existing UnifiedBody action through adapter",
    "preserve body conservation checks",
    "checkpoint and decision feedback committed to one SQLite transaction"
  ],
  "limits": [
    "constructed deterministic fixtures, no blinded/general capability claim",
    "estimated input scores are assumed and not calibrated"
  ],
